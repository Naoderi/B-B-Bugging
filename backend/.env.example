# Optional: copy this file to .env beside server.py. Restart after changing it.
# Shell / hosting environment variables override .env. Do not commit real keys.
# Stay offline even if keys exist elsewhere in your environment.
CAMPUS_COACH_PROVIDER=offline
# To enable later: change to anthropic or asi1, and set that provider's key below.
# auto selects Claude when its key exists, then ASI:One, otherwise offline.
# CAMPUS_PRICE_CSV=/absolute/path/to/licensed-adjusted-closes.csv
# CAMPUS_LEDGER=/absolute/path/to/local-paper.sqlite3
# Claude requires: .venv/bin/python -m pip install -r requirements-ai.txt
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-opus-5-5
# ASI:One needs no additional Python package.
# ASI_ONE_API_KEY=your-asi-one-key
# ASI_ONE_MODEL=asi1
# Countersign through the Guardian uAgent instead of in-process. Fails closed if unreachable.
# CAMPUS_GUARDIAN_URL=http://127.0.0.1:8101/countersign
# CAMPUS_GUARDIAN_SEED=a-private-phrase-of-16-or-more-characters
# CAMPUS_COACH_SEED=another-private-phrase-of-16-or-more-characters
# python.org macOS builds need root certificates for HTTPS: run "Install Certificates.command"
# once, or export SSL_CERT_FILE="$(.venv/bin/python -m certifi)".
